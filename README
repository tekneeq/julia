--

Step 1 — see what snapshots you have:
UV_NATIVE_TLS=true uv run lia greeks-history --ticker SPY --expiration 2026-07-24

Step 2 — pick a pair with --from and --to:
# Default: latest vs previous (equivalent to --from 2 --to 1)
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24

# Latest vs the very first ever recorded for this expiration
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24 --from first --to latest

# Latest vs the 3rd-most-recent (skip a snapshot)
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24 --from 3 --to 1

# Compare two specific snapshots by ULID (copy-paste from greeks-history)
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24 \
  --from 01KXV5Y0KRMCPJ5144GVVPYZTC \
  --to   01KXV84QRJ2BZBRD0XY2YGM3Q7

# You can also mix — e.g. specific old ULID vs latest
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24 \
  --from 01KXV5Y0KRMCPJ5144GVVPYZTC --to latest

  # Right now — records snapshot A
lia oi-dashboard --ticker SPY --expiration 2026-07-24

# Monday close — records snapshot B
lia oi-dashboard --ticker SPY --expiration 2026-07-24 --refresh-cache
UV_NATIVE_TLS=true uv run lia oi-dashboard --ticker SPY --expiration 2026-07-24 --refresh-cache

# Default diff = B vs A, no flags needed:
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24
UV_NATIVE_TLS=true uv run lia oi-dashboard-diff --ticker SPY --expiration 2026-07-24 


--from / --to ref types accepted by oi-dashboard-diff:

| Ref             | Meaning                                                               |
|-----------------|-----------------------------------------------------------------------|
| latest / last   | The most recent snapshot                                              |
| first           | The oldest snapshot ever recorded for that ticker+expiration          |
| A number (N)    | N-th most recent (1 = latest, 2 = second-most-recent, ...)            |
| A full ULID     | Direct lookup by ID (copy from `greeks-history`)                      |


# Batch oi-dashboard across a date range (skips weekends, runs in parallel)
# Every business day in the range, SPY only, 4 workers
./scripts/oi_batch.py --from 2026-07-27 --to 2026-07-31

# Multiple tickers, more workers, custom flags forwarded to lia
./scripts/oi_batch.py --from 2026-07-27 --to 2026-07-31 \
    --tickers SPY,QQQ,IWM --workers 6 --extra "--range 10"

# Preview commands without executing
./scripts/oi_batch.py --from 2026-07-27 --to 2026-07-31 --dry-run

# Skip --refresh-cache if you just want to (re)plot from cached chain
./scripts/oi_batch.py --from 2026-07-27 --to 2026-07-31 --no-refresh-cache


# nightly, near market close
./scripts/oi_batch.py --from $(date -j -f "%Y-%m-%d" "$(date +%Y-%m-%d)" +%Y-%m-%d) --to 2026-08-14

# next morning, spot changes overnight
lia oi-dashboard-diff --ticker SPY --expiration 2026-07-28


# Live Streamlit dashboard:
#   • TradingView-style live session chart (price in $, crosshair, prev-close
#     baseline) fed tick-by-tick by scripts/price_poller.py
#   • Historical twin panels (the two closest past sessions, side by side)
#   • Interactive Plotly time series of the crossing strike per expiration
#     (see how the positioning "pin" drifts over time as new snapshots arrive)
#   • Latest 3-panel oi-dashboard PNGs
#   • Auto-refresh every 5s, or manual "▶ Run batch" button in the sidebar
UV_NATIVE_TLS=true uv run streamlit run scripts/oi_dashboard_app.py

# Then open http://localhost:8501 in your browser.


# Live price poller — the high-resolution feed for the "Today's price
# action" chart. One quote per ticker every 5s during market hours,
# written to the spot_ticks table. Independent of the 30-min OI scheduler
# (oi_scheduler.py), which stays on options-chain duty.
./scripts/price_poller.py                  # foreground, SPY every 5s
./scripts/price_poller.py --status         # is it up? tick coverage today
./scripts/price_poller.py --once           # auth smoke test
./scripts/price_poller.py --stop

# From the host, inside the docker container (detached, like the scheduler):
./restart-price-poller.sh                  # start / restart
./restart-price-poller.sh --status
./restart-price-poller.sh --logs
# Note: like the scheduler, a detached docker exec does not survive a
# container restart — run this again after ./restart.sh or a reboot.


# -----------------------------------------------------------------------------
# Auto-deploy on push (EC2)
# -----------------------------------------------------------------------------
# Pushes to ``main`` trigger .github/workflows/deploy-ec2.yml, which SSHes
# into the box and runs ``./deploy.sh``:
#   1. ./restart.sh                 git pull + rebuild julia-dashboard
#   2. ./restart-oi-scheduler.sh    re-attach scheduler (dies with container)
#   3. ./restart-price-poller.sh    re-attach price poller
#
# One-time GitHub setup (repo → Settings → Secrets and variables → Actions):
#   EC2_HOST              e.g. 54.91.65.71
#   EC2_USER              ec2-user
#   EC2_SSH_PRIVATE_KEY   full contents of the .pem (including BEGIN/END lines)
# Optional:
#   EC2_SSH_PORT          default 22
#   EC2_APP_DIR           default /home/ec2-user/julia
#
# EC2 security group: allow inbound TCP 22 from GitHub Actions (or, for a
# small personal box, temporarily 0.0.0.0/0 — tighten later). The deploy
# key should be the instance key pair (or a dedicated deploy key in
# ~/.ssh/authorized_keys).
#
# Manual / test deploy from your laptop:
#   ssh ec2-user@<host> 'cd ~/julia && ./deploy.sh'
# Or use the Actions tab → "Deploy to EC2" → Run workflow.
#
# Fallback without GitHub→SSH (poll every 2 min on the box itself):
#   */2 * * * * cd /home/ec2-user/julia && git fetch origin main && \
#     [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ] && \
#     ./deploy.sh >> /home/ec2-user/julia/logs/deploy.log 2>&1


# -----------------------------------------------------------------------------
# Docker (recommended for EC2 / older-glibc hosts)
# -----------------------------------------------------------------------------
# Amazon Linux 2 (glibc 2.26) doesn't have wheels for modern pyarrow, torch,
# onnxruntime, etc. Running the dashboard in a Docker container sidesteps the
# host glibc entirely. The image is based on Debian 12 (glibc 2.36).

# One-time install of Docker on Amazon Linux 2:
sudo yum update -y
sudo amazon-linux-extras install docker -y
sudo systemctl enable --now docker
sudo usermod -aG docker ec2-user
# log out & back in so the group takes effect

# Build & run with docker compose (uses ./docker-compose.yml)
docker compose up --build -d

# Or plain docker (equivalent):
docker build -t julia-dashboard:latest .
docker run --rm -it \
    -p 8501:8501 \
    -v $(pwd)/.options_cache:/app/.options_cache \
    -v $(pwd)/plots:/app/plots \
    -v $(pwd)/logs:/app/logs \
    --env-file .env \
    julia-dashboard:latest

# Then open http://<ec2-public-ip>:8501/ in your browser.
# Don't forget to allow TCP 8501 in the EC2 security group inbound rules.

# Tail dashboard logs
docker compose logs -f dashboard

# Stop & remove container
docker compose down

# One-off CLI inside the container (e.g., check history)
docker compose exec dashboard uv run lia greeks-history --ticker SPY --limit 10

# Force a fresh batch run inside the container (bypassing the button)
docker compose exec dashboard ./scripts/oi_batch.py \
    --from 2026-07-27 --to 2026-07-31 --tickers SPY

UV_NATIVE_TLS=true uv run streamlit run scripts/oi_dashboard_app.py \
    --server.address 0.0.0.0 --server.port 8501




