sudo docker build -t julia-dashboard:latest .

sudo docker rm -f julia-dashboard 2>/dev/null
sudo docker run -d \
    --name julia-dashboard \
    --restart unless-stopped \
    -p 8501:8501 \
    -v $(pwd)/.options_cache:/app/.options_cache \
    -v $(pwd)/plots:/app/plots \
    -v $(pwd)/logs:/app/logs \
    --env-file .env \
    julia-dashboard:latest
# Tail logs
sudo docker logs -f julia-dashboard
# Stop (leaves the container in place)
sudo docker stop julia-dashboard
# Full restart
sudo docker restart julia-dashboard




