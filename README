sudo crontab -e


TZ=America/New_York
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Every 30 min, market hours, weekdays. Fresh Robinhood pull every time.
0,30 9-16 * * 1-5  cd /home/ec2-user/julia && /usr/bin/docker exec julia-dashboard uv run python scripts/oi_batch.py --rolling-days 5 --tickers SPY >> /home/ec2-user/julia/logs/cron-oi-batch.log 2>&1

# One extra run 5 min after close (redundant flag, but explicit)
5 16 * * 1-5       cd /home/ec2-user/julia && /usr/bin/docker exec julia-dashboard uv run python scripts/oi_batch.py --rolling-days 5 --tickers SPY --refresh-cache >> /home/ec2-user/julia/logs/cron-oi-batch.log 2>&1


sudo crontab -l                    # should show the entries above
ls -la /home/ec2-user/julia/logs/  # cron-oi-batch.log will appear after the first fire
